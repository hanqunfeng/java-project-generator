#compdef springboot

# Zsh completion：子命令与子命令参数补全。
_springboot_cached_deps_zsh() {
  local script_dir cache_file
  script_dir="${${(%):-%N}:A:h:h}"
  cache_file=(${script_dir}/deps-cache/boot-*.md(N[1]))
  [[ -z "$cache_file" ]] && return 0
  awk -F'|' '
    /^\|/ {
      id=$3
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
      if (id != "" && id != "ID" && id != "---") {
        print id
      }
    }
  ' "$cache_file"
}

_springboot_filter_used_opts() {
  local -a all_opts available
  local word word_base opt opt_base cur used

  reply=()
  all_opts=("$@")
  cur="${words[CURRENT]}"

  for opt in "${all_opts[@]}"; do
    opt_base="${opt%%=*}"
    used=0
    for word in "${words[@]}"; do
      [[ "$word" == --* ]] || continue
      word_base="${word%%=*}"
      if [[ "$word_base" == "$opt_base" && "$word" != "$cur" ]]; then
        used=1
        break
      fi
    done
    if (( ! used )); then
      available+=("$opt")
    fi
  done

  reply=("${available[@]}")
}

_springboot_complete_assignment_values() {
  local prefix value_prefix value
  local -a values candidates

  prefix="$1"
  shift
  values=("$@")
  value_prefix="${words[CURRENT]#${prefix}}"

  for value in "${values[@]}"; do
    [[ "$value" == ${value_prefix}* ]] && candidates+=("${prefix}${value}")
  done

  compadd -Q -S '' -- "${candidates[@]}"
}

local curcontext="$curcontext" state line
typeset -A opt_args

if [[ "${words[CURRENT]}" == --deps=* ]]; then
  local dep_values dep_prefix
  dep_prefix="${words[CURRENT]#--deps=}"
  dep_values=("${(@f)$(_springboot_cached_deps_zsh)}")
  if (( ${#dep_values[@]} > 0 )); then
    compadd -Q -S '' -- ${(M)dep_values:#${dep_prefix}*}
  fi
  return
fi

if (( CURRENT == 2 )); then
  _arguments \
    '--help[显示帮助信息]' \
    '--version[显示脚本版本]' \
    '1:command:(create module deps)'
  return
fi

local cmd="${words[2]}"
local create_long_opts module_add_long_opts deps_list_long_opts deps_preview_long_opts
create_long_opts=(
  --help --dry-run --name= --boot= --type= --packaging= --modules= --config=
  --java= --language= --gradle-dsl= --group= --artifact= --artifact-version= --desc= --pkg= --deps=
)
module_add_long_opts=(
  --help --dry-run --name= --module= --module-packaging= --module-path= --boot=
  --type= --packaging= --config= --java= --language= --gradle-dsl= --group= --artifact= --artifact-version=
  --desc= --pkg= --deps=
)
module_list_long_opts=(--help --name= --type= --module-path=)
module_remove_long_opts=(--help --dry-run --name= --type= --module= --module-path=)
deps_list_long_opts=(--help --boot= --output= --refresh)
deps_preview_long_opts=(--help --deps= --boot= --type= --java= --language= --gradle-dsl=)
deps_search_long_opts=(--help --query= --boot= --refresh)

case "$cmd" in
  create)
    case "${words[CURRENT]}" in
      --type=*) _springboot_complete_assignment_values "--type=" maven gradle; return ;;
      --packaging=*) _springboot_complete_assignment_values "--packaging=" jar war pom; return ;;
      --config=*) _springboot_complete_assignment_values "--config=" properties yaml; return ;;
      --java=*) _springboot_complete_assignment_values "--java=" 17 21 25; return ;;
      --language=*) _springboot_complete_assignment_values "--language=" java kotlin groovy; return ;;
      --gradle-dsl=*) _springboot_complete_assignment_values "--gradle-dsl=" groovy kotlin; return ;;
    esac
    if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
      local cur_word
      cur_word="${words[CURRENT]}"
      _springboot_filter_used_opts "${create_long_opts[@]}"
      compadd -Q -S '' -- ${(M)reply:#${cur_word}*}
      return
    fi
    _arguments -s \
      '--help[显示 create 命令帮助]' \
      '--dry-run[仅打印执行计划]' \
      '--name=[项目名]:name:' \
      '--boot=[Spring Boot 版本]:boot:' \
      '--type=[构建工具]:type:(maven gradle)' \
      '--packaging=[打包方式]:packaging:(jar war pom)' \
      '--modules=[子模块列表，逗号分隔]:modules:' \
      '--config=[配置文件格式]:config:(properties yaml)' \
      '--java=[Java 版本]:java:(17 21 25)' \
      '--language=[代码语言]:language:(java kotlin groovy)' \
      '--gradle-dsl=[Gradle DSL]:gradle-dsl:(groovy kotlin)' \
      '--group=[Group Id]:group:' \
      '--artifact=[Artifact Id]:artifact:' \
      '--artifact-version=[项目版本]:artifact-version:' \
      '--desc=[项目描述]:desc:' \
      "--pkg=[根包名（默认同 --group，自动把 '-' 转 '_'）]:pkg:" \
      '--deps=[依赖 ID 列表，逗号分隔]:deps:'
    ;;
  module)
    if (( CURRENT == 3 )); then
      _arguments '2:subcommand:(add list remove)'
      return
    fi
    local module_sub="${words[3]}"
    case "$module_sub" in
      add)
        case "${words[CURRENT]}" in
          --type=*) _springboot_complete_assignment_values "--type=" maven gradle; return ;;
          --packaging=*) _springboot_complete_assignment_values "--packaging=" pom; return ;;
          --module-packaging=*) _springboot_complete_assignment_values "--module-packaging=" jar pom; return ;;
          --config=*) _springboot_complete_assignment_values "--config=" properties yaml; return ;;
          --java=*) _springboot_complete_assignment_values "--java=" 17 21 25; return ;;
          --language=*) _springboot_complete_assignment_values "--language=" java kotlin groovy; return ;;
          --gradle-dsl=*) _springboot_complete_assignment_values "--gradle-dsl=" groovy kotlin; return ;;
        esac
        if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
          local cur_word
          cur_word="${words[CURRENT]}"
          _springboot_filter_used_opts "${module_add_long_opts[@]}"
          compadd -Q -S '' -- ${(M)reply:#${cur_word}*}
          return
        fi
        _arguments -s \
          '--help[显示 module add 命令帮助]' \
          '--dry-run[仅打印执行计划]' \
          '--name=[目标项目名]:name:' \
          '--module=[新增子模块名]:module:' \
          '--module-packaging=[子模块打包方式]:module-packaging:(jar pom)' \
          '--module-path=[父模块路径]:module-path:' \
          '--boot=[Spring Boot 版本]:boot:' \
          '--type=[构建工具]:type:(maven gradle)' \
          '--packaging=[打包方式，仅支持 pom]:packaging:(pom)' \
          '--config=[配置文件格式]:config:(properties yaml)' \
          '--java=[Java 版本]:java:(17 21 25)' \
          '--language=[代码语言]:language:(java kotlin groovy)' \
          '--gradle-dsl=[Gradle DSL]:gradle-dsl:(groovy kotlin)' \
          '--group=[Group Id]:group:' \
          '--artifact=[Artifact Id]:artifact:' \
          '--artifact-version=[项目版本]:artifact-version:' \
          '--desc=[项目描述]:desc:' \
          "--pkg=[根包名（默认同 --group，自动把 '-' 转 '_'）]:pkg:" \
          '--deps=[依赖 ID 列表，逗号分隔]:deps:'
        ;;
      list)
        if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
          local cur_word
          cur_word="${words[CURRENT]}"
          _springboot_filter_used_opts "${module_list_long_opts[@]}"
          compadd -Q -S '' -- ${(M)reply:#${cur_word}*}
          return
        fi
        _arguments -s \
          '--help[显示 module list 命令帮助]' \
          '--name=[目标项目名]:name:' \
          '--type=[构建工具]:type:(maven gradle)' \
          '--module-path=[父模块路径]:module-path:'
        ;;
      remove)
        if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
          local cur_word
          cur_word="${words[CURRENT]}"
          _springboot_filter_used_opts "${module_remove_long_opts[@]}"
          compadd -Q -S '' -- ${(M)reply:#${cur_word}*}
          return
        fi
        _arguments -s \
          '--help[显示 module remove 命令帮助]' \
          '--dry-run[仅打印执行计划]' \
          '--name=[目标项目名]:name:' \
          '--type=[构建工具]:type:(maven gradle)' \
          '--module=[子模块名]:module:' \
          '--module-path=[父模块路径]:module-path:'
        ;;
      *)
        _arguments '2:subcommand:(add list remove)'
        ;;
    esac
    ;;
  deps)
    if (( CURRENT == 3 )); then
      _arguments '2:subcommand:(list preview search)'
      return
    fi
    local deps_sub="${words[3]}"
    case "$deps_sub" in
      list)
        case "${words[CURRENT]}" in
          --output=*) _springboot_complete_assignment_values "--output=" terminal web; return ;;
        esac
        if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
          local cur_word
          cur_word="${words[CURRENT]}"
          _springboot_filter_used_opts "${deps_list_long_opts[@]}"
          compadd -Q -S '' -- ${(M)reply:#${cur_word}*}
          return
        fi
        _arguments -s \
          '--help[显示 deps list 命令帮助]' \
          '--boot=[Spring Boot 版本]:boot:' \
          '--output=[输出方式]:output:(terminal web)'
        ;;
      preview)
        case "${words[CURRENT]}" in
          --type=*) _springboot_complete_assignment_values "--type=" maven gradle; return ;;
          --java=*) _springboot_complete_assignment_values "--java=" 17 21 25; return ;;
          --language=*) _springboot_complete_assignment_values "--language=" java kotlin groovy; return ;;
          --gradle-dsl=*) _springboot_complete_assignment_values "--gradle-dsl=" groovy kotlin; return ;;
        esac
        if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
          local cur_word
          cur_word="${words[CURRENT]}"
          _springboot_filter_used_opts "${deps_preview_long_opts[@]}"
          compadd -Q -S '' -- ${(M)reply:#${cur_word}*}
          return
        fi
        _arguments -s \
          '--help[显示 deps preview 命令帮助]' \
          '--deps=[依赖 ID 列表，逗号分隔]:deps:' \
          '--boot=[Spring Boot 版本]:boot:' \
          '--type=[构建工具]:type:(maven gradle)' \
          '--java=[Java 版本]:java:(17 21 25)' \
          '--language=[代码语言]:language:(java kotlin groovy)' \
          '--gradle-dsl=[Gradle DSL]:gradle-dsl:(groovy kotlin)'
