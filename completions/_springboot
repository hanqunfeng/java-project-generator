      search)
        if [[ -z "${words[CURRENT]}" || "${words[CURRENT]}" == --* ]]; then
          local cur_word
          cur_word="${words[CURRENT]}"
          _springboot_filter_used_opts "${deps_search_long_opts[@]}"
