        plan_echo "FLOW" "$(t "Select a generator from packaging='${packaging}' and type='${projectType}'" "根据 packaging='${packaging}' 与 type='${projectType}' 选择生成策略")"
        if [[ "$packaging" == "pom" ]]; then
