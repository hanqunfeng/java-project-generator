                --help|-h)
                    print_help_boot_list
                    exit 0
                    ;;
                --refresh)
                    depsForceRefresh=true
                    ;;
                *)
                    log_error "boot list 模式未知参数: $arg"
                    print_help_boot_list
                    exit "$EXIT_PARAM"
                    ;;
            esac
        done
        list_boot_versions
        ;;
esac
