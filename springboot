run_project_mode() {
    echo "===== 项目配置 ====="
    echo "  动作:         $action"
    echo "  项目名:       $projectName"
    echo "  Dry Run:      $dryRun"
    echo "  Boot版本:     $bootVersion"
    echo "  构建工具:     $projectType"
    echo "  打包方式:     $packaging"
    if [[ "$packaging" == "pom" && -n "$subModules" ]]; then
        echo "  子模块:       $subModules"
    fi
    if [[ "$action" == "add-module" ]]; then
        echo "  新增模块:     $addModuleName"
        echo "  模块打包:     $modulePackaging"
        if [ -n "$modulePath" ]; then
            echo "  父模块路径:   $modulePath"
        else
            echo "  父模块路径:   <项目根>"
        fi
        if [[ "$modulePackaging" == "pom" ]]; then
            echo "  依赖说明:     module-packaging=pom 时忽略 --deps"
        fi
    fi
    if [[ "$action" == "add-module" && "$projectType" == "maven" ]]; then
        echo "  说明:         Maven module add 会以父 pom.xml 的真实 groupId/artifactId/version 作为 parent 坐标"
    fi
    echo "  配置文件:     $configFormat"
    echo "  Java版本:     $javaVersion"
    echo "  Group Id:     $groupId"
    echo "  Artifact Id:  $artifactId"
    echo "  项目版本:     $projectVersion"
    echo "  描述:         $description"
    echo "  根包名:       $packageName"
    if [[ "$packaging" == "pom" ]]; then
        echo "  子模块依赖:   $dependencies"
    else
        echo "  依赖ID:       $dependencies"
    fi
    echo "===================="

    if [[ "$dryRun" == "true" ]]; then
        echo "Dry-run 模式：仅输出执行计划，不会创建或修改任何文件。"
        plan_step=0
        plan_echo "CHECK" "参数解析与校验完成"
        plan_echo "FLOW" "根据 packaging='${packaging}' 与 type='${projectType}' 选择生成策略"
        if [[ "$packaging" == "pom" ]]; then
            if [[ "$projectType" == "maven" ]]; then
                plan_echo "FLOW" "进入 Maven 多模块策略脚本: ${SCRIPT_DIR}/lib/multi-maven.sh"
                source "${SCRIPT_DIR}/lib/multi-maven.sh"
            else
                plan_echo "FLOW" "进入 Gradle 多模块策略脚本: ${SCRIPT_DIR}/lib/multi-gradle.sh"
                source "${SCRIPT_DIR}/lib/multi-gradle.sh"
            fi
        else
            plan_echo "FLOW" "进入单模块策略脚本: ${SCRIPT_DIR}/lib/single.sh"
            source "${SCRIPT_DIR}/lib/single.sh"
        fi
        exit 0
    fi

    if [[ "$packaging" == "pom" ]]; then
        if [[ "$projectType" == "maven" ]]; then
            source "${SCRIPT_DIR}/lib/multi-maven.sh"
        else
            source "${SCRIPT_DIR}/lib/multi-gradle.sh"
        fi
    else
        source "${SCRIPT_DIR}/lib/single.sh"
    fi

    echo ""
    if [[ "$action" == "add-module" ]]; then
        log_success "子模块追加完成，可继续在项目中开发。"
    else
        log_success "项目创建完成，请使用惯用IDE打开项目目录，比如："
        echo "    cursor ${projectName}"
        echo "    idea ${projectName}"
    fi
}

mode=""
depsOutput=""
depsPreviewCsv=""

if [ "$#" -eq 0 ]; then
    print_help_root
    exit "$EXIT_PARAM"
fi

case "$1" in
    --help|-h)
        print_help_root
        exit 0
        ;;
    --version|-v)
        echo "springboot ${SCRIPT_VERSION}"
        exit 0
        ;;
    create)
        mode="create"
        shift
        ;;
    module)
        shift
        if [ "$#" -eq 0 ]; then
            print_help_module
            exit "$EXIT_PARAM"
        fi
        case "$1" in
            --help|-h)
                print_help_module
                exit 0
                ;;
            add)
                mode="module-add"
                shift
                ;;
            *)
                log_error "未知子命令: module $1"
                print_help_module
                exit "$EXIT_PARAM"
                ;;
        esac
        ;;
    deps)
        shift
        if [ "$#" -eq 0 ]; then
            print_help_deps
            exit "$EXIT_PARAM"
        fi
        case "$1" in
            --help|-h)
                print_help_deps
                exit 0
                ;;
            list)
                mode="deps-list"
                shift
                ;;
            preview)
                mode="deps-preview"
                shift
                ;;
            *)
                log_error "未知子命令: deps $1"
                print_help_deps
                exit "$EXIT_PARAM"
                ;;
        esac
        ;;
    *)
        log_error "未知命令: $1"
        print_help_root
        exit "$EXIT_PARAM"
        ;;
esac

case "$mode" in
    create)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_create; exit 0 ;;
                --dry-run) dryRun=true ;;
                --name=*) projectName="${1#*=}" ;;
                --boot=*) bootVersion="${1#*=}" ;;
                --type=*) projectType="${1#*=}" ;;
                --packaging=*) packaging="${1#*=}" ;;
                --modules=*) subModules="${1#*=}" ;;
                --config=*) configFormat="${1#*=}" ;;
                --java=*) javaVersion="${1#*=}" ;;
                --group=*) groupId="${1#*=}" ;;
                --artifact=*) artifactId="${1#*=}" ;;
                --artifact-version=*) projectVersion="${1#*=}" ;;
                --desc=*) description="${1#*=}" ;;
                --pkg=*) packageName="${1#*=}" ;;
                --deps=*) dependencies="${1#*=}" ;;
                *)
                    log_error "create 模式未知参数: $1"
                    print_help_create
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done

        action="create"
        dryRun=${dryRun:-false}
        bootVersion=${bootVersion:-3.5.14}
        projectType=${projectType:-maven}
        packaging=${packaging:-jar}
        configFormat=${configFormat:-properties}
        javaVersion=${javaVersion:-17}
        groupId=${groupId:-com.example}
        artifactId=${artifactId:-$projectName}
        projectVersion=${projectVersion:-0.0.1}
        description=${description:-Demo project for Spring Boot}
        packageName=${packageName:-$(printf '%s' "$groupId" | tr '-' '_')}
        dependencies=${dependencies:-web,devtools}
        dependencies=$(normalize_deps_csv "$dependencies")
        subModules=$(normalize_modules_csv "${subModules:-}")
        modulePackaging=${modulePackaging:-jar}
        modulePackagingSpecified=${modulePackagingSpecified:-false}
        modulePathSpecified=${modulePathSpecified:-false}
        modulePath=${modulePath:-}

        validate_create_args
        if [[ "$dryRun" != "true" ]]; then
            if [[ "$packaging" != "pom" ]]; then
                validate_dependencies_against_initializr "$dependencies"
                resolve_starter_boot_param_key
                bootParamKeyStarter="${STARTER_BOOT_PARAM_KEY:-bootVersion}"
            elif [[ "$dependencies" != "web,devtools" ]]; then
                validate_dependencies_against_initializr "$dependencies"
            fi
        fi
        run_project_mode
        ;;

    module-add)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_module_add; exit 0 ;;
                --dry-run) dryRun=true ;;
                --name=*) projectName="${1#*=}" ;;
                --module=*) addModuleName="${1#*=}" ;;
                --module-packaging=*)
                    modulePackaging="${1#*=}"
                    modulePackagingSpecified=true
                    ;;
                --module-path=*)
                    modulePath="${1#*=}"
                    modulePathSpecified=true
                    ;;
                --boot=*) bootVersion="${1#*=}" ;;
                --type=*) projectType="${1#*=}" ;;
                --packaging=*) packaging="${1#*=}" ;;
                --config=*) configFormat="${1#*=}" ;;
                --java=*) javaVersion="${1#*=}" ;;
                --group=*) groupId="${1#*=}" ;;
                --artifact=*) artifactId="${1#*=}" ;;
                --artifact-version=*) projectVersion="${1#*=}" ;;
                --desc=*) description="${1#*=}" ;;
                --pkg=*) packageName="${1#*=}" ;;
                --deps=*) dependencies="${1#*=}" ;;
                *)
                    log_error "module add 模式未知参数: $1"
                    print_help_module_add
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done

        action="add-module"
        dryRun=${dryRun:-false}
        bootVersion=${bootVersion:-3.5.14}
        projectType=${projectType:-maven}
        packaging=${packaging:-pom}
        configFormat=${configFormat:-properties}
        javaVersion=${javaVersion:-17}
        groupId=${groupId:-com.example}
        artifactId=${artifactId:-$projectName}
        projectVersion=${projectVersion:-0.0.1}
        description=${description:-Demo project for Spring Boot}
        packageName=${packageName:-$(printf '%s' "$groupId" | tr '-' '_')}
        dependencies=${dependencies:-web,devtools}
        dependencies=$(normalize_deps_csv "$dependencies")
        subModules=""
        modulePackaging=${modulePackaging:-jar}
        modulePackagingSpecified=${modulePackagingSpecified:-false}
        modulePathSpecified=${modulePathSpecified:-false}
        modulePath=${modulePath:-}

        validate_module_add_args
        if [[ "$dryRun" != "true" && "$modulePackaging" == "jar" && "$dependencies" != "web,devtools" ]]; then
            validate_dependencies_against_initializr "$dependencies"
        fi
        run_project_mode
        ;;

    deps-list)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_deps_list; exit 0 ;;
                --boot=*) bootVersion="${1#*=}" ;;
                --output=*) depsOutput="${1#*=}" ;;
                *)
                    log_error "deps list 模式未知参数: $1"
                    print_help_deps_list
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        bootVersion=${bootVersion:-3.5.14}
        depsOutput=${depsOutput:-terminal}
        validate_deps_list_args
        if [[ "$depsOutput" == "web" ]]; then
            open_dependency_catalog_web
        else
            echo "-- 使用如下命令：springboot deps list --boot=${bootVersion} --output=web ，可以使用浏览器打开"
            echo "可选依赖列表 (bootVersion=${bootVersion}):"
            print_dependency_catalog
        fi
        ;;

    deps-preview)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_deps_preview; exit 0 ;;
                --deps=*) depsPreviewCsv="${1#*=}" ;;
                --boot=*) bootVersion="${1#*=}" ;;
                --type=*) projectType="${1#*=}" ;;
                --java=*) javaVersion="${1#*=}" ;;
                *)
                    log_error "deps preview 模式未知参数: $1"
                    print_help_deps_preview
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        bootVersion=${bootVersion:-3.5.14}
        projectType=${projectType:-maven}
        javaVersion=${javaVersion:-17}
        depsPreviewCsv=$(normalize_deps_csv "$depsPreviewCsv")
        validate_deps_preview_args
        print_dependencies_declaration "$depsPreviewCsv"
        ;;
esac
