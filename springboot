#!/usr/bin/env bash
set -o pipefail
# ========= 脚本说明 =========
# 本脚本用于快速生成一个新的 Spring Boot 项目（单模块或多模块）。
# 用法:
#   1. 给予脚本执行权限: chmod +x springboot
#   2. 将脚本目录加入系统 PATH 后，即可全局使用:
#      springboot <command> [options]
#
# 命令:
#   create              创建项目（单模块或多模块）
#   module add          向已有多模块项目追加子模块
#   deps list           查看依赖列表（--output=terminal|web）
#   deps preview        输出依赖声明片段
#
# 示例:
#   springboot create --name=mydemo
#   springboot module add --name=myproject --type=maven --module=api --deps=webflux
#   springboot deps list --boot=3.5.14 --output=terminal
#   springboot deps preview --type=gradle --deps=web,data-jpa --boot=3.5.14

# 定位脚本真实所在目录（兼容符号链接调用，例如 /usr/local/bin/springboot）。
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SCRIPT_VERSION="1.0.6"
source "${SCRIPT_DIR}/lib/arg-common.sh"

# 统一退出码约定：
# - EXIT_PARAM: 参数不合法、校验失败
# - EXIT_NETWORK: 网络请求失败
# - EXIT_FS: 文件系统操作失败（目录/文件不存在、写入失败等）
# - EXIT_DEP: 外部依赖缺失（pandoc/glow/python3 等）
EXIT_PARAM=1
EXIT_NETWORK=2
EXIT_FS=3
EXIT_DEP=4

# 运行期间创建的临时文件集合。
# 通过 trap 统一清理，避免异常退出残留垃圾文件。
tmp_files=()

# -----------------------------------------------------------------------------
# 函数: register_tmp_file
# 作用: 把临时文件路径登记到全局清理队列。
# 入参:
#   $1 -> 临时文件绝对路径
# 返回:
#   0 -> 总是成功（空路径会被忽略）
# 失败:
#   无显式失败分支
# -----------------------------------------------------------------------------
register_tmp_file() {
    local file="$1"
    [ -n "$file" ] && tmp_files+=("$file")
}

# -----------------------------------------------------------------------------
# 函数: cleanup_tmp_files
# 作用: 退出前统一删除登记的临时文件，避免污染系统临时目录。
# 入参: 无
# 返回: 0
# 失败: 清理失败会被吞掉（|| true），不影响主流程退出码
# -----------------------------------------------------------------------------
cleanup_tmp_files() {
    if [ "${#tmp_files[@]}" -gt 0 ]; then
        rm -f -- "${tmp_files[@]}" 2>/dev/null || true
    fi
}

trap cleanup_tmp_files EXIT INT TERM

# -----------------------------------------------------------------------------
# 函数: is_color_enabled
# 作用: 判断当前终端是否启用彩色输出。
# 条件:
#   1) stdout 为 TTY
#   2) 未显式设置 NO_COLOR 环境变量
# 返回:
#   0 -> 启用彩色
#   1 -> 不启用彩色
# -----------------------------------------------------------------------------
is_color_enabled() {
    [ -t 1 ] && [ -z "${NO_COLOR:-}" ]
}

# -----------------------------------------------------------------------------
# 函数: color_print
# 作用: 统一颜色输出入口，避免各处重复 ANSI 控制逻辑。
# 入参:
#   $1   -> ANSI 颜色码（如 31 红色、32 绿色）
#   $2.. -> 输出文本
# 返回: 0
# -----------------------------------------------------------------------------
color_print() {
    local colorCode="$1"
    shift
    if is_color_enabled; then
        printf '\033[%sm%s\033[0m\n' "$colorCode" "$*"
    else
        printf '%s\n' "$*"
    fi
}

# 语义化日志快捷函数（信息/警告/错误/成功）。
log_info() { color_print "36" "$*"; }
log_warn() { color_print "33" "$*"; }
log_error() { color_print "31" "$*"; }
log_success() { color_print "32" "$*"; }

