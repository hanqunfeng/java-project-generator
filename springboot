            fi
        else
            plan_echo "FLOW" "$(t "Enter single-module script: ${SCRIPT_DIR}/lib/single.sh" "进入单模块策略脚本: ${SCRIPT_DIR}/lib/single.sh")"
            source "${SCRIPT_DIR}/lib/single.sh"
        fi
        exit 0
    fi

    if [[ "$packaging" == "pom" ]]; then
        if [[ "$projectType" == "maven" ]]; then
            source "${SCRIPT_DIR}/lib/multi-maven.sh"
        else
            source "${SCRIPT_DIR}/lib/multi-gradle.sh"
        fi
    else
        source "${SCRIPT_DIR}/lib/single.sh"
    fi

    echo ""
    if [[ "$action" == "add-module" ]]; then
        log_success "$(t "Module added. You can continue developing in the project." "子模块追加完成，可继续在项目中开发。")"
    else
        log_success "$(t "Project created. Open the project directory in your IDE, for example:" "项目创建完成，请使用惯用IDE打开项目目录，比如：")"
        echo "    cursor ${projectName}"
        echo "    idea ${projectName}"
    fi
}

mode=""
depsOutput=""
depsPreviewCsv=""
depsSearchQuery=""

if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
        run_interactive_wizard
    fi
    print_help_root
    exit "$EXIT_PARAM"
fi

case "$1" in
    --help|-h)
        print_help_root
        exit 0
        ;;
    --version|-v)
        echo "springboot ${SCRIPT_VERSION}"
        exit 0
        ;;
    create)
        mode="create"
        shift
        ;;
    module)
        shift
        if [ "$#" -eq 0 ]; then
            print_help_module
            exit "$EXIT_PARAM"
        fi
        case "$1" in
            --help|-h)
                print_help_module
                exit 0
                ;;
            add)
                mode="module-add"
                shift
                ;;
            list)
                mode="module-list"
                shift
                ;;
            remove)
                mode="module-remove"
                shift
                ;;
            *)
                log_error "$(t "Unknown subcommand: module $1" "未知子命令: module $1")"
                print_help_module
                exit "$EXIT_PARAM"
                ;;
        esac
        ;;
    deps)
        shift
        if [ "$#" -eq 0 ]; then
            print_help_deps
            exit "$EXIT_PARAM"
        fi
        case "$1" in
            --help|-h)
                print_help_deps
                exit 0
                ;;
            list)
                mode="deps-list"
                shift
                ;;
            preview)
                mode="deps-preview"
                shift
                ;;
            search)
                mode="deps-search"
                shift
                ;;
            *)
                log_error "$(t "Unknown subcommand: deps $1" "未知子命令: deps $1")"
                print_help_deps
                exit "$EXIT_PARAM"
                ;;
        esac
        ;;
    boot)
        shift
        if [ "$#" -eq 0 ]; then
            print_help_boot
            exit "$EXIT_PARAM"
        fi
        case "$1" in
            --help|-h)
                print_help_boot
                exit 0
                ;;
            list)
                mode="boot-list"
                shift
                ;;
            *)
                log_error "$(t "Unknown subcommand: boot $1" "未知子命令: boot $1")"
                print_help_boot
                exit "$EXIT_PARAM"
                ;;
        esac
        ;;
    *)
        log_error "$(t "Unknown command: $1" "未知命令: $1")"
        print_help_root
        exit "$EXIT_PARAM"
        ;;
esac

case "$mode" in
    create)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_create; exit 0 ;;
                --dry-run) dryRun=true ;;
                --name=*) projectName="${1#*=}" ;;
                --boot=*)
                    bootVersion="${1#*=}"
                    bootVersionSpecified=true
                    ;;
                --type=*) projectType="${1#*=}" ;;
                --packaging=*) packaging="${1#*=}" ;;
                --modules=*) subModules="${1#*=}" ;;
                --config=*) configFormat="${1#*=}" ;;
                --java=*) javaVersion="${1#*=}" ;;
                --language=*) projectLanguage="${1#*=}" ;;
                --gradle-dsl=*) gradleDsl="${1#*=}" ;;
                --group=*) groupId="${1#*=}" ;;
                --artifact=*) artifactId="${1#*=}" ;;
                --artifact-version=*) projectVersion="${1#*=}" ;;
                --desc=*) description="${1#*=}" ;;
                --pkg=*) packageName="${1#*=}" ;;
                --deps=*) dependencies="${1#*=}" ;;
                *)
                    log_error "$(t "Unknown create argument: $1" "create 模式未知参数: $1")"
                    print_help_create
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done

        action="create"
        dryRun=${dryRun:-false}
        bootVersionSpecified=${bootVersionSpecified:-false}
        projectType=${projectType:-maven}
        packaging=${packaging:-jar}
        configFormat=${configFormat:-properties}
        javaVersion=${javaVersion:-17}
        groupId=${groupId:-com.example}
        artifactId=${artifactId:-$projectName}
        projectVersion=${projectVersion:-0.0.1}
        description=${description:-Demo project for Spring Boot}
        packageName=${packageName:-$(printf '%s' "$groupId" | tr '-' '_')}
        projectLanguage=${projectLanguage:-java}
        gradleDsl=${gradleDsl:-groovy}
        dependencies=${dependencies:-$DEFAULT_DEPS}
        dependencies=$(normalize_deps_csv "$dependencies")
        subModules=$(normalize_modules_csv "${subModules:-}")
        modulePackaging=${modulePackaging:-jar}
        modulePackagingSpecified=${modulePackagingSpecified:-false}
        modulePathSpecified=${modulePathSpecified:-false}
        modulePath=${modulePath:-}

        resolve_project_boot_version
        validate_create_args
        if [[ "$dryRun" != "true" ]]; then
            if [[ "$packaging" != "pom" ]]; then
                validate_dependencies_against_initializr "$dependencies"
                resolve_starter_boot_param_key
                bootParamKeyStarter="${STARTER_BOOT_PARAM_KEY:-bootVersion}"
            elif [[ "$dependencies" != "$DEFAULT_DEPS" ]]; then
                validate_dependencies_against_initializr "$dependencies"
            fi
        fi
        run_project_mode
        ;;

    module-add)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_module_add; exit 0 ;;
                --dry-run) dryRun=true ;;
                --name=*) projectName="${1#*=}" ;;
                --module=*) addModuleName="${1#*=}" ;;
                --module-packaging=*)
                    modulePackaging="${1#*=}"
                    modulePackagingSpecified=true
                    ;;
                --module-path=*)
                    modulePath="${1#*=}"
                    modulePathSpecified=true
                    ;;
                --boot=*)
                    bootVersion="${1#*=}"
                    bootVersionSpecified=true
                    ;;
                --type=*) projectType="${1#*=}" ;;
                --packaging=*) packaging="${1#*=}" ;;
                --config=*) configFormat="${1#*=}" ;;
                --java=*) javaVersion="${1#*=}" ;;
                --language=*) projectLanguage="${1#*=}" ;;
                --gradle-dsl=*) gradleDsl="${1#*=}" ;;
                --group=*) groupId="${1#*=}" ;;
                --artifact=*) artifactId="${1#*=}" ;;
                --artifact-version=*) projectVersion="${1#*=}" ;;
                --desc=*) description="${1#*=}" ;;
                --pkg=*) packageName="${1#*=}" ;;
                --deps=*) dependencies="${1#*=}" ;;
                *)
                    log_error "$(t "Unknown module add argument: $1" "module add 模式未知参数: $1")"
                    print_help_module_add
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done

        action="add-module"
        dryRun=${dryRun:-false}
        bootVersionSpecified=${bootVersionSpecified:-false}
        projectType=${projectType:-maven}
        packaging=${packaging:-pom}
        configFormat=${configFormat:-properties}
        javaVersion=${javaVersion:-17}
        groupId=${groupId:-com.example}
        artifactId=${artifactId:-$projectName}
        projectVersion=${projectVersion:-0.0.1}
        description=${description:-Demo project for Spring Boot}
        packageName=${packageName:-$(printf '%s' "$groupId" | tr '-' '_')}
        projectLanguage=${projectLanguage:-java}
        gradleDsl=${gradleDsl:-groovy}
        dependencies=${dependencies:-$DEFAULT_DEPS}
        dependencies=$(normalize_deps_csv "$dependencies")
        subModules=""
        modulePackaging=${modulePackaging:-jar}
        modulePackagingSpecified=${modulePackagingSpecified:-false}
        modulePathSpecified=${modulePathSpecified:-false}
        modulePath=${modulePath:-}

        resolve_project_boot_version
        validate_module_add_args
        if [[ "$dryRun" != "true" && "$modulePackaging" == "jar" && "$dependencies" != "$DEFAULT_DEPS" ]]; then
            validate_dependencies_against_initializr "$dependencies"
        fi
        run_project_mode
        ;;

    module-list)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_module_list; exit 0 ;;
                --name=*) projectName="${1#*=}" ;;
                --type=*) projectType="${1#*=}" ;;
                --module-path=*) modulePath="${1#*=}" ;;
                *)
                    log_error "$(t "Unknown module list argument: $1" "module list 模式未知参数: $1")"
                    print_help_module_list
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        projectType=${projectType:-maven}
        modulePath=${modulePath:-}
        if [ -z "${projectName:-}" ]; then
            log_error "$(t "module list requires --name=<project name>" "module list 必须提供 --name=<项目名>")"
            exit "$EXIT_PARAM"
        fi
        module_list_command
        ;;

    module-remove)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_module_remove; exit 0 ;;
                --dry-run) dryRun=true ;;
                --name=*) projectName="${1#*=}" ;;
                --type=*) projectType="${1#*=}" ;;
                --module=*) addModuleName="${1#*=}" ;;
                --module-path=*) modulePath="${1#*=}" ;;
                *)
                    log_error "$(t "Unknown module remove argument: $1" "module remove 模式未知参数: $1")"
                    print_help_module_remove
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        dryRun=${dryRun:-false}
        projectType=${projectType:-maven}
        modulePath=${modulePath:-}
        if [ -z "${projectName:-}" ] || [ -z "${addModuleName:-}" ]; then
            log_error "$(t "module remove requires --name and --module" "module remove 必须提供 --name 和 --module")"
            exit "$EXIT_PARAM"
        fi
        module_remove_command
        ;;

    deps-list)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_deps_list; exit 0 ;;
                --boot=*)
                    bootVersion="${1#*=}"
                    bootVersionSpecified=true
                    ;;
                --output=*) depsOutput="${1#*=}" ;;
                --refresh) depsForceRefresh=true ;;
                *)
                    log_error "$(t "Unknown deps list argument: $1" "deps list 模式未知参数: $1")"
                    print_help_deps_list
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        bootVersionSpecified=${bootVersionSpecified:-false}
        depsOutput=${depsOutput:-terminal}
        if [[ "$bootVersionSpecified" != "true" ]]; then
            resolve_project_boot_version
        fi
        validate_deps_list_args
        if [[ "$depsOutput" == "web" ]]; then
            open_dependency_catalog_web
        else
            say "-- Run: springboot deps list --boot=${bootVersion} --output=web to open the list in a browser" "-- 使用如下命令：springboot deps list --boot=${bootVersion} --output=web ，可以使用浏览器打开"
            say "Available dependencies (bootVersion=${bootVersion}):" "可选依赖列表 (bootVersion=${bootVersion}):"
            print_dependency_catalog
        fi
        ;;

    deps-preview)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_deps_preview; exit 0 ;;
                --deps=*) depsPreviewCsv="${1#*=}" ;;
                --boot=*)
                    bootVersion="${1#*=}"
                    bootVersionSpecified=true
                    ;;
                --type=*) projectType="${1#*=}" ;;
                --java=*) javaVersion="${1#*=}" ;;
                --language=*) projectLanguage="${1#*=}" ;;
                --gradle-dsl=*) gradleDsl="${1#*=}" ;;
                *)
                    log_error "$(t "Unknown deps preview argument: $1" "deps preview 模式未知参数: $1")"
                    print_help_deps_preview
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        bootVersionSpecified=${bootVersionSpecified:-false}
        projectType=${projectType:-maven}
        javaVersion=${javaVersion:-17}
        projectLanguage=${projectLanguage:-java}
        gradleDsl=${gradleDsl:-groovy}
        depsPreviewCsv=$(normalize_deps_csv "$depsPreviewCsv")
        if [[ "$bootVersionSpecified" != "true" ]]; then
            resolve_project_boot_version
        fi
        validate_deps_preview_args
        print_dependencies_declaration "$depsPreviewCsv"
        ;;

    deps-search)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --help|-h) print_help_deps_search; exit 0 ;;
                --query=*) depsSearchQuery="${1#*=}" ;;
                --boot=*)
                    bootVersion="${1#*=}"
                    bootVersionSpecified=true
                    ;;
                --refresh) depsForceRefresh=true ;;
                *)
                    log_error "$(t "Unknown deps search argument: $1" "deps search 模式未知参数: $1")"
                    print_help_deps_search
                    exit "$EXIT_PARAM"
                    ;;
            esac
            shift
        done
        bootVersionSpecified=${bootVersionSpecified:-false}
        depsOutput=${depsOutput:-terminal}
        if [[ "$bootVersionSpecified" != "true" ]]; then
            resolve_project_boot_version
        fi
        validate_deps_list_args
        deps_search_command "$depsSearchQuery"
        ;;

    boot-list)
        for arg in "$@"; do
            case "$arg" in
                --help|-h)
                    print_help_boot_list
                    exit 0
                    ;;
                --refresh)
                    depsForceRefresh=true
                    ;;
                *)
                    log_error "$(t "Unknown boot list argument: $arg" "boot list 模式未知参数: $arg")"
                    print_help_boot_list
                    exit "$EXIT_PARAM"
                    ;;
            esac
        done
        list_boot_versions
        ;;
esac
